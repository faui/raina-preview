+"""Regenerate docs/CONTENT_APPROVAL_MATRIX.md from the approval notes stored with each treatment.
+
+Run from the theme root: python tools/build_approval_matrix.py
+The `approval` arrays in site/data/treatments.php are the single source of truth for page-level facts awaiting the practice.
+"""
+import json, re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+text = (ROOT / 'site' / 'data' / 'treatments.php').read_text(encoding='utf-8')
+data = json.loads(re.search(r"<<<'RAINA_JSON'\n(.*)\nRAINA_JSON;", text, re.S).group(1))
+GATED = {'massage', 'dermal-fillers', 'pain-management', 'sleep-apnea'}
+UTILITY = [
+    ('/', 'Homepage', 'Clinical lead + owner', ['Hero copy naming both dentists; trust band (DDS, New York University, 2002); fluoride-free / mercury-free / mercury-safe definitions', 'Homepage review excerpts (gated by "reviews approved" setting)', 'Membership prices and inclusions', 'Office hours and address']),
+    ('/care/team/', 'Our dentists', 'Each dentist personally', ['Dr. Mandeep Raina: DDS New York University 2002; advanced training in implant rehabilitation and full-mouth reconstruction; volunteer background; interests', 'Dr. Prameela B: exact professional name, degree, school, licence; scope (restorative, cosmetic, family); interests', 'Approved portraits for both dentists (Dr. Prameela portrait is a placeholder)', 'Remove the static “14 years” claim from any legacy copy (not used here)']),
+    ('/care/patient-stories/', 'Patient stories', 'Owner + compliance', ['Seven verbatim Google review excerpts and display names (first name + initial) — republication rights', 'Google review link target']),
+    ('/care/appointments/', 'Schedule a visit', 'Owner + front desk', ['Phone-only scheduling as the approved fallback UX', 'Current PatientViewer URL (legacy URL on old site is malformed with a tracking suffix)', 'What to bring list; reschedule notice wording', 'Whether new-patient vs existing-patient paths exist in the scheduler']),
+    ('/care/contact/', 'Contact & directions', 'Owner', ['Address, phone, weekday hours, weekend wording (“Call for information”), holiday policy', 'Suite/entrance, parking and accessibility details (not published; only “mention it when you schedule”)', 'Facebook URL (numeric page used; a “RainaDentalCareBolingbrook” page also exists)']),
+    ('/care/payment/', 'Insurance & payment', 'Owner + billing lead', ['In-/out-of-network status: old homepage says “accept and bill out-of-network insurance”; old contact page says “Most Insurances Accepted” — reconcile', 'Whether claims are filed for patients; pre-treatment estimates', 'Cards (Visa, Mastercard, Amex, Discover) and CareCredit — still accepted?']),
+    ('/care/membership/', 'Membership', 'Owner', ['Adult $62.50/mo or $750/yr; Child (12 and under) $43.33/mo or $520/yr; listed inclusions', 'Enrollment mechanism, billing, renewal, cancellation, exclusions, member fee schedule']),
+    ('/care/approach/', 'Our approach', 'Clinical lead', ['Definitions of biological dentistry, fluoride-free, mercury-free and mercury-safe', 'Statements about evidence and amalgam removal']),
+    ('/care/technology/', 'Technology', 'Clinical lead', ['Which imaging/scanning equipment is installed and used (none is claimed as owned); illustrative stock image must be replaced or kept labelled']),
+    ('/care/privacy/', 'Website privacy', 'Attorney / privacy officer', ['Website notice describes actual theme behaviour (no trackers, no forms, assistant data flow); hosting logs, any plugins/analytics added later; link to Notice of Privacy Practices']),
+    ('/journal/ (+6 articles)', 'Journal', 'Clinical editor', ['All six articles: authorship, sources, clinical accuracy; enable “journal approved” only after sign-off']),
+]
+
+lines = ['# Content approval matrix', '',
+         'Generated by `tools/build_approval_matrix.py` from the `approval` notes stored beside each page’s copy. '
+         'Status for every row is **PENDING PRACTICE APPROVAL** — no item below has been approved by the practice. '
+         'Copy was written by the development team from the practice’s previously published website and general patient-education sources; '
+         'it must be reviewed by a dentist before launch.', '',
+         '| Route | Page | Publish state today | Facts the practice must confirm | Approver |', '|---|---|---|---|---|']
+for slug, t in data.items():
+    state = 'Gated: 404 in public-launch mode until approved in Raina Website settings' if slug in GATED else 'Public in launch mode (staging noindex)'
+    facts = '<br>'.join('• ' + a.replace('|', '/') for a in t.get('approval', []))
+    lines.append(f"| `/care/{slug}/` | {t['h1']} | {state} | {facts} | Treating dentist (clinical) |")
+for route, name, who, facts in UTILITY:
+    lines.append(f"| `{route}` | {name} | {'Gated until approved' if 'Journal' in name or 'stories' in name else 'Public in launch mode (staging noindex)'} | {'<br>'.join('• ' + f for f in facts)} | {who} |")
+(ROOT / 'docs' / 'CONTENT_APPROVAL_MATRIX.md').write_text('\n'.join(lines) + '\n', encoding='utf-8')
+print('rows', len(data) + len(UTILITY))
